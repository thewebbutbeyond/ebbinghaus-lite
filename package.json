{
  "name": "ebbinghaus-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "build:portal": "npm run typecheck && vite build --config vite.portal.config.ts",
    "portal:demo": "node server/demo.ts",
    "portal:account": "node server/account.ts",
    "portal:start": "node server/main.ts",
    "test:portal": "npm run build && npm run build:portal && playwright test --config playwright.portal.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vite": "~8.3.5"
  }
}
